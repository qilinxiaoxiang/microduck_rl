  "tasks": [
    {
      "id": "A",
      "purpose": "把呼唤、取球请求和取消绑定到原始呼唤者。",
      "change": "单一音频源分流给唤醒/转写，再接已有解析器；逐步接入真实身份线索。",
      "first": "从 starter/interaction 运行 python3 run.py；再运行 python3 run.py --events call_then_fetch。",
      "output": "共享音频适配器、带来源的录音/转写标签、JSON 事件和分项错误计数。",
      "acceptance": "既定正负例无错误启动，取消匹配原始用户；两个消费者收到相同块/时间；真实身份不得用 fixtures 冒充。",
      "dependency": "解析器可独立开始；真实 caller binding 依赖 B，动作/cancel 依赖 E/身体执行器。"
    },
    {
      "id": "B",
      "purpose": "出程盯住所选球，返程重认原始呼唤者，向 C 请求视线和速度。",
      "change": "在现有橙色检测上加稳定目标选择/跟踪、人物重认、年龄和丢失处理；保留错例。",
      "first": "在已装依赖环境中从 starter/vision 运行 python run.py --out out，查看图片、tracks 和已知橙色矩形误检。",
      "output": "回放命令、视频叠加、带 identity/capture_t 的轨迹和 gaze/velocity 请求。",
      "acceptance": "冻结正负片段后报告 recall/误选/ID 切换/旧指令时长；错人、身份不明、过期时停止接近。",
      "dependency": "图像/协议独立；身体映射需要 F0/C，取球入口依赖 D，人物身份依赖 A，阶段选择依赖 E。"
    },
    {
      "id": "C",
      "purpose": "边看地面边走/转/停，随后接 D 的负载状态运输。",
      "change": "先重现低头抖动，再比较一个腿部参考约束改动；不靠拒走或不低头获得平滑。",
      "first": "从 starter/motion 运行 python replay.py locomotion --out out/gait.json。",
      "output": "历史失败诊断、双条件评估代码/配置、一个明确比较、支持的视线/速度/负载范围及模型适配说明。",
      "acceptance": "当前增量复现真实 trace 指标；F0 后改善预先选择的故障指标同时保留视线/速度跟踪和稳定停步，经过受保护实机试验才接 B/D。",
      "dependency": "CPU 诊断独立；新机体训练和实机依赖 F0；加载步行依赖 D 的实际负载出口。"
    },
    {
      "id": "D",
      "purpose": "从真实接近状态连续取球、起身并交付可运输的稳定负载出口。",
      "change": "把任务延长到含球起身/下游准入，保留姿态/速度/动作/视觉历史，增加有效 lift/hold/exit 判定和退出路径。",
      "first": "从 starter/motion 运行 python replay.py pickup --out out/handoff.json，查看弯颈差异和 pick→stand 后跌倒时间线。",
      "output": "连续过渡评估、单变量训练比较、入口/出口区域、负载证据、失败与 abort。",
      "acceptance": "F0 后由 B/C 实际出口起步，无 reset 完成离地、保留、起身、C 搬运/停步；空咬、跌落和跌倒分开计数。",
      "dependency": "历史诊断独立；新训练依赖 F0；开发可用共享 baseline，不先等新 C；最终要 B/C 连续入口、C 出口联合验收。"
    },
    {
      "id": "E",
